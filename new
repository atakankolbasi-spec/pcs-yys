                              <td><span class="status-pill ${v.onsite?'active onsite':''}" data-toggle="onsite" data-id="${v.id}">${v.onsite?'✓ EVET':'HAYIR'}</span></td>
                              <td><span class="status-pill ${v.t1?'active t1':''}" data-toggle="t1" data-id="${v.id}">${v.t1?'✓ EVET':'HAYIR'}</span></td>
                              <td><span class="status-pill ${v.done?'active done':''}" data-toggle="done" data-id="${v.id}">${v.done?'✓ EVET':'HAYIR'}</span></td>
                              <td>${esc(v.carrier||'—')}</td>
                              <td style="font-family:var(--font-mono);">${esc(v.time||'—')}</td>
                              <td>
                                <div style="display:flex; gap:6px;">
                                  <button class="whatsapp-btn" data-action="wa" data-id="${v.id}">${icon('whatsapp')}</button>
                                  <button class="btn btn-sm btn-icon" data-action="delete" data-id="${v.id}" style="color:#ef4444;">${icon('trash')}</button>
                                </div>
                              </td>
                            </tr>
                          `).join('')}
                        </tbody>
                      </table>
                    </div>
                  `
                }
              </section>
            `;
          }).join('')}
        </div>
      </main>

      <!-- Mobile Bottom Navigation -->
      <nav class="mobile-bottom-nav">
        <button class="mob-nav-item ${ui.page==='pano'?'active':''}" data-page="pano">${icon('grid')}<span>Pano</span></button>
        <button class="mob-nav-item ${ui.page==='pending'?'active':''}" data-page="pending">${icon('clock')}<span>Bekleyen</span></button>
        <button class="mob-nav-item ${ui.page==='registry'?'active':''}" data-page="registry">${icon('registry')}<span>Plakalar</span></button>
        <button class="mob-nav-item" id="mob-add-btn" style="color:var(--brand-blue);">${icon('plus')}<span>Ekle</span></button>
      </nav>
    </div>
  `;

  // Attach search focus restore
  const sBox = document.getElementById('search-box');
  if(sBox && document.activeElement?.id === 'search-box'){
    sBox.focus();
    sBox.setSelectionRange(sBox.value.length, sBox.value.length);
  }
}

// Event Listeners
document.addEventListener('click', e => {
  const btn = e.target.closest('button');
  if(!btn) return;
  
  if(btn.dataset.page){ ui.page = btn.dataset.page; render(); return; }
  if(btn.dataset.view){ ui.viewMode = btn.dataset.view; render(); return; }
  if(btn.dataset.filter){ ui.filterStatus = btn.dataset.filter; render(); return; }
  if(btn.dataset.day){ ui.day = btn.dataset.day; render(); return; }
  
  if(btn.id === 'btn-prev-wk'){ ui.week = Math.max(1, ui.week - 1); render(); return; }
  if(btn.id === 'btn-next-wk'){ ui.week = ui.week + 1; render(); return; }
  
  if(btn.dataset.toggle){
    const field = btn.dataset.toggle;
    const id = btn.dataset.id;
    const item = state.visits.find(x => x.id === id);
    if(item){
      item[field] = !item[field];
      toast(`${item.plate} durumu güncellendi.`);
      render();
    }
    return;
  }
  
  if(btn.dataset.action === 'advance'){
    advanceVisitStatus(btn.dataset.id);
    return;
  }
  
  if(btn.dataset.action === 'wa'){
    const item = state.visits.find(x => x.id === btn.dataset.id);
    if(item) openWhatsApp(item);
    return;
  }
  
  if(btn.dataset.action === 'delete'){
    if(confirm('Bu araç geliş kaydını silmek istiyor musunuz?')){
      state.visits = state.visits.filter(x => x.id !== btn.dataset.id);
      toast('Araç kaydı silindi.');
      render();
    }
    return;
  }

  if(btn.id === 'btn-add-vehicle' || btn.id === 'mob-add-btn' || btn.dataset.action === 'add-to-day'){
    const targetDate = btn.dataset.date || (ui.day !== 'all' ? ui.day : TODAY);
    const p = prompt('Yeni Araç Plakası:');
    if(!p || !p.trim()) return;
    const c = prompt('Müşteri Adı:') || 'Genel Müşteri';
    state.visits.push({
      id: uid(),
      plate: p.trim(),
      customer: c.trim(),
      declaration: '',
      carrier: '',
      registration: '',
      date: targetDate,
      time: '09:00',
      onsite: true,
      t1: false,
      done: false,
      note: ''
    });
    toast(`${p.toUpperCase()} aracı eklendi.`);
    render();
    return;
  }
});

document.addEventListener('input', e => {
  if(e.target.id === 'search-box'){
    ui.search = e.target.value;
    render();
  }
});

render();
})();
</script>
</body>
</html>
