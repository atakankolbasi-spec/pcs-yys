/* Toast */
#toast { position: fixed; bottom: 24px; right: 24px; background: var(--brand-navy); color: #ffffff; padding: 12px 20px; border-radius: var(--radius-md); box-shadow: var(--shadow-lg); font-size: 13px; font-weight: 700; z-index: 100; opacity: 0; transform: translateY(10px); transition: all 0.2s ease; pointer-events: none; }
#toast.show { opacity: 1; transform: translateY(0); }
#toast.error { background: #dc2626; }

/* Responsive Mobile Rules */
@media (max-width: 900px) {
  .app-sidebar { display: none; }
  .app-main { margin-left: 0; }
  .topbar { padding: 0 16px; }
