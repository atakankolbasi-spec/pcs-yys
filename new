  whatsapp: '<path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/>',
  zap: '<polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/>',
  edit: '<path d="M14 5l5 5M4 20l4-1L20 7a2.1 2.1 0 00-3-3L5 16z"/>',
  trash: '<path d="M3 6h18M9 6V3h6v3M6 6l1 15h10l1-15M10 10v7m4-7v7"/>',
  download: '<path d="M12 3v12m-5-5l5 5 5-5M4 16v5h16v-5"/>'
};

const icon = (n, cls='') => `<svg class="${cls}" viewBox="0 0 24 24" aria-hidden="true">${I[n]||I.grid}</svg>`;
const esc = v => String(v ?? '').replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const norm = p => String(p||'').normalize('NFKC').toUpperCase().replace(/\u0130/g,'I').replace(/[\s.-]+/g,'');
const plateText = p => String(p||'').trim().toUpperCase().replace(/\s+/g,' ');
const uid = () => globalThis.crypto?.randomUUID?.() || ('id-'+Date.now().toString(36)+'-'+Math.random().toString(36).slice(2));

function localToday(){
  const p = new Intl.DateTimeFormat('en-GB',{timeZone:'Europe/Istanbul',year:'numeric',month:'2-digit',day:'2-digit'}).formatToParts(new Date());
  const x = t => p.find(a=>a.type===t).value;
  return `${x('year')}-${x('month')}-${x('day')}`;
}
const TODAY = localToday();

function dateObj(s){ return new Date(s+'T12:00:00Z'); }
function addDays(s, n){ return new Date(dateObj(s).getTime()+n*86400000).toISOString().slice(0,10); }
function weekInfo(s){
  let d = dateObj(s);
  d.setUTCHours(0,0,0,0);
  d.setUTCDate(d.getUTCDate()+4-(d.getUTCDay()||7));
  const y = d.getUTCFullYear();
  return {year:y, week:Math.ceil((((d-new Date(Date.UTC(y,0,1)))/86400000)+1)/7)};
}
function monday(y,w){
  const d = new Date(Date.UTC(y,0,4,12));
  d.setUTCDate(d.getUTCDate()-(d.getUTCDay()||7)+1+(w-1)*7);
  return d.toISOString().slice(0,10);
}
const weekNow = weekInfo(TODAY);

let ui = {
  page: 'pano',
  viewMode: window.innerWidth < 850 ? 'cards' : 'table',
  filterStatus: 'all',
  year: weekNow.year,
  week: weekNow.week,
  day: 'all',
  search: ''
};

let state = {
  registry: [],
  visits: [
    {id:'demo-1', plate:'34 FF 8177', customer:'ETL LOJİSTİK - ERVİN', declaration:'BYN-2026-901', carrier:'BULTRANS LTD', registration:'34-FF-8177-RUH', date:TODAY, time:'09:15', onsite:true, t1:true, done:false, note:'Evrak kontrolü yapıldı.'},
    {id:'demo-2', plate:'X 4627 EM', customer:'TORNADO EXPRESS', declaration:'BYN-2026-902', carrier:'TORNADO NAKLİYAT', registration:'X4627EM', date:TODAY, time:'10:30', onsite:true, t1:false, done:false, note:'Tesis girişinde.'},
    {id:'demo-3', plate:'B 509 MIL', customer:'LİN TRANSPORT', declaration:'BYN-2026-903', carrier:'LİN LOJİSTİK', registration:'B509MIL', date:TODAY, time:'11:45', onsite:true, t1:true, done:true, note:'İşlemler tamamlandı, çıkış yapabilir.'}
  ]
};

const weekStart = () => monday(ui.year, ui.week);
const dates = () => Array.from({length:6}, (_,i) => addDays(weekStart(), i));
const weekVisits = () => { const ds = dates(); return state.visits.filter(v => ds.includes(v.date)); };
const stats = arr => ({
  total: arr.length,
  onsite: arr.filter(v => v.onsite).length,
  t1: arr.filter(v => v.t1).length,
  done: arr.filter(v => v.done).length,
  pending: arr.filter(v => !v.done).length
});

function toast(msg, isErr=false){
  const el = document.getElementById('toast');
  el.textContent = msg;
  el.className = 'show' + (isErr ? ' error' : '');
  setTimeout(() => el.className = '', 3500);
}

function renderPlate(p){
  const clean = plateText(p);
  return `<span class="tr-plate"><span class="tr-flag">TR</span><span class="tr-num">${esc(clean)}</span></span>`;
}

function openWhatsApp(v){
  const st = v.done ? 'gümrük ve T1 işlemleri tamamlanmıştır. Araç tesisten çıkış yapabilir.' : 
             (v.t1 ? 'T1 beyannamesi yazılmıştır, gümrük kontrolleri devam etmektedir.' : 
             (v.onsite ? 'aracı tesisimize giriş yapmıştır, evrak sırasına alınmıştır.' : 'araç geliş kaydı sisteme işlenmiştir.'));
  const txt = `*PCS TRANSİT YYS BİLGİLENDİRME*\n\nSayın Yetkili,\n*${v.plate}* plakalı ${v.customer ? v.customer + ' ' : ''}aracınızın ${st}\n\nBeyanname: ${v.declaration || '—'}\nTarih: ${v.date}\nİyi çalışmalar dileriz.`;
  window.open(`https://wa.me/?text=${encodeURIComponent(txt)}`, '_blank');
}

function advanceVisitStatus(id){
  const v = state.visits.find(x => x.id === id);
  if(!v) return;
  if(!v.onsite && !v.t1 && !v.done){ v.onsite = true; toast(`${v.plate} Tesiste yapıldı.`); }
  else if(v.onsite && !v.t1 && !v.done){ v.t1 = true; toast(`${v.plate} T1 Yazıldı yapıldı.`); }
  else if(v.t1 && !v.done){ v.done = true; toast(`${v.plate} İşlemler Bitti olarak tamamlandı.`); }
  else { v.onsite = false; v.t1 = false; v.done = false; toast(`${v.plate} durumu sıfırlandı.`); }
  render();
}

