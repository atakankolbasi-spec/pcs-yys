<script>
(() => {
'use strict';
const STORE = 'pcs-transit-yys.v1';
const DAYS = ['Pazartesi','Salı','Çarşamba','Perşembe','Cuma','Cumartesi'];
const SHORT_DAYS = ['Pzt','Sal','Çar','Per','Cum','Cmt'];
const I = {
